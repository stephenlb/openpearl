# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
OPENPEARL_APP_PASSWORD=change-me-too
# Ed25519 public key that bundles are signed with (node deploy/keygen.js <dir>)
OPENPEARL_VERIFY_KEY_FILE=./keys/signing.pub.pem
# {"<sha256 of bearer token>": {"tenant": "...", "user": "...", "roles": []}}
OPENPEARL_SERVE_TOKENS={}
# Intake service (optional profile: docker compose --profile intake up)
OPENPEARL_INTAKE_TOKENS={}
OPENPEARL_INTAKE_KEY=
OPENPEARL_REPO=owner/repo
OPENPEARL_GITHUB_TOKEN=
